{
  "schema": "yihetong-profile-consumer-map-v1",
  "authorityFlow": [
    "CustomerDeploymentProfile",
    "profile-authority-map.json",
    "system_brand_config",
    "GET /api/v1/brand-config/active",
    "website, management admin, user admin, Mini Program and H5 consumers"
  ],
  "surfaces": [
    {
      "id": "backend-brand-authority",
      "source": "esign-api/esign-api/esign-infrastructure/src/main/java/com/xuran/esign/infra/system/dal/dataobject/SystemBrandConfigDO.java",
      "requiredTokens": ["logoSquare", "homeBannerImages", "websiteEnabled", "websiteContentJson"]
    },
    {
      "id": "management-admin",
      "source": "esign-manage-admin/src/store/modules/app/index.ts",
      "requiredTokens": ["getBrandConfig", "logoIcon", "logoSquare", "runtimeConfig"]
    },
    {
      "id": "user-admin",
      "source": "esign-pc-admin/src/store/modules/app/index.ts",
      "requiredTokens": ["getBrandConfig", "logoIcon", "logoSquare", "runtimeConfig"]
    },
    {
      "id": "mini-and-h5",
      "source": "esign-mini/store/index.js",
      "requiredTokens": ["homeBannerImages", "agentApplyBackground", "inviteBackground", "customerServiceQrCode", "personalRegisterGiftContractCount", "enterpriseRegisterGiftContractCount", "shareTitle", "shareDesc"]
    },
    {
      "id": "website",
      "source": "website/lib/site-config.ts",
      "requiredTokens": ["websiteEnabled", "websiteDomain", "websiteCtaText", "websiteUserUrl", "websiteManageUrl", "websiteH5Url", "websiteMiniProgramQrCode", "websiteContentJson"]
    },
    {
      "id": "mini-build-identity",
      "source": "deploy/scripts/build-vnext-release.ps1",
      "requiredTokens": ["MiniAppId", "build-uni-platforms.ps1", "-MiniAppId $MiniAppId"]
    }
  ],
  "notes": {
    "h5": "H5 and Mini Program are built from the shared esign-mini uni-app source; the AppID gate applies only to mp-weixin.",
    "fixedSigningPlatform": "Public fixed signing-platform endpoints are product dependencies and are not customer Profile defaults.",
    "secrets": "Profile secret:// references are resolved through protected inputs; consumer payloads contain no plaintext credentials."
  }
}
