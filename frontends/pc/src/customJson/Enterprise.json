{
  "search": {
    "type": 1
  },
  "list": {
    "title": "企业合同列表",
    "getList": {
      "requestUrl": "/mgt/v1/contract?showCompany=true",
      "requestType": "get",
      "requestResult": {
        "data": "data",
        "transRules": [{
            "old": "rows",
            "new": "list"
        }]
      }
    }
  },
  "detail": {
    "title": "详情",
    "getDetail": {
      "requestUrl": "/mgt/v5/contract",
      "paramsType": "link",
      "requestParams": ["id"],
      "requestType": "get"
    },
    "group": [
      {
        "title": "",
        "id": 1,
        "data": []
      }
    ]
  },
  "fieldList": [
    {
      "label": "合同名称",
      "fieldName": "searchName",
      "useName": "a-input",
      "placeholder": "请输入合同名称",
      "search": {
        "sort": 0,
        "defaultValue": ""
      }
    },
    {
      "label": "合同名称",
      "fieldName": "name",
      "useName": "a-input",
      "placeholder": "请输入合同名称",
      "list": {
        "sort": 0,
        "slot": true
      },
      "detail": {
        "sort": 0,
        "groupId": 1
      }
    },
    {
      "label": "发起方",
      "fieldName": "initiatorName",
      "useName": "a-input",
      "list": {
        "sort": 1,
        "slot": true
      },
      "detail": {
        "sort": 0,
        "groupId": 1
      }
    },
    {
      "label": "发起时间",
      "fieldName": "startTime",
      "useName": "a-input",
      "options": [],
      "placeholder": "全部",
      "list": {
        "sort": 3,
        "slot": true
      },
      "detail": {
        "sort": 0,
        "groupId": 1
      }
    },
    {
      "label": "签署时间",
      "fieldName": "endTime",
      "useName": "a-input",
      "list": {
        "sort": 5,
        "slot": true
      },
      "detail": {
        "sort": 0,
        "groupId": 1
      }
    },
    {
      "label": "参与人",
      "fieldName": "signers",
      "useName": "a-input",
      "list": {
        "sort": 5,
        "slot": true
      },
      "detail": {
        "sort": 0,
        "groupId": 1,
        "show": {
          "type": "Array",
          "showField": "userName"
        }
      }
    },
    {
      "label": "状态",
      "fieldName": "state",
      "useName": "a-select",
      "options": [
        {
          "label": "待处理",
          "value": 0
        },
        {
          "label": "已完成",
          "value": 1
        },
        {
          "label": "已拒签",
          "value": 2
        },
        {
          "label": "已撤销",
          "value": 3
        },
        {
          "label": "已逾期",
          "value": 4
        },
        {
          "label": "流产",
          "value": 5
        }
      ],
      "list": {
        "sort": 6,
        "slot": true
      },
      "detail": {
        "sort": 0,
        "groupId": 1
      }
    }
  ],
  "listOperates": [
    {
        "name": "查看",
        "operate": "filePreview",
        "filePreview": {
          "requestUrl": "/mgt/v5/contract/",
          "paramsType": "link",
          "requestParams": ["id"],
          "requestType": "get",
          "params": "url"
        },
        "show": [{
          "fieldName": "state",
          "value": 1
        }]
    },
    {
      "name": "下载",
      "operate": "download",
      "download": {
        "useType": "request",
        "params": "url",
        "fileName": "name",
        "fileAfter": ".pdf",
        "requestUrl": "/mgt/v5/contract/",
        "requestParams": ["id"],
        "paramsType": "link",
        "requestType": "get"
      },
      "show": [{
        "fieldName": "state",
        "value": 1
      }]
    }
  ],
  "batchOperates": []
}
